# Detection Toolkit v0.1 settings. Copy to .env, adjust, then load it with:
#   set -a; . ./.env; set +a
# Every value is optional; the defaults are shown.

# Bind address and port for `python -m detection_toolkit serve`.
DTK_HOST=127.0.0.1
DTK_PORT=5000

# Runtime files (SQLite database, secret key). Relative paths resolve from the project directory.
DTK_DATA_DIR=data
# Relative paths resolve from DTK_DATA_DIR.
DTK_DB_PATH=detection_toolkit.sqlite3

# Host names the app answers to (protects against DNS rebinding). Use * to disable the check.
DTK_TRUSTED_HOSTS=127.0.0.1,localhost

# Leave empty to use the key that init-db writes to $DTK_DATA_DIR/secret_key.
# If you set it, use at least 32 random characters, e.g. from: python3 -c "import secrets; print(secrets.token_hex(32))"
DTK_SECRET_KEY=

DTK_LOG_LEVEL=INFO
